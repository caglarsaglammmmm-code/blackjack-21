rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tek elde bakiye en çok 2,5 katına çıkabilir (tüm parayla blackjack).
    // Başlangıç parası 500 olduğundan ilk kayıt 1250'yi geçemez.
    function validShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'best', 'updatedAt'])
        && data.keys().hasAll(['name', 'best', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 16
        && data.best is number
        && data.best <= 1000000000000
        && data.updatedAt == request.time;
    }

    match /scores/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && validShape()
        && request.resource.data.best >= 500
        && request.resource.data.best <= 1250;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && validShape()
        && request.resource.data.best >= resource.data.best
        && request.resource.data.best <= resource.data.best * 2.5
        && request.time > resource.data.updatedAt + duration.value(1, 's');

      allow delete: if false;
    }
  }
}
